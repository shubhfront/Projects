import tkinter as tk
from tkinter import messagebox
import random
import ctypes

root = tk.Tk()
root.title("Guess number")
root.resizable(False, False)
icon = tk.PhotoImage(file="icon.png")
root.iconphoto(False, icon)
root.config(bg = "#EDEDBD")

GCL_STYLE = -26
CS_DROPSHADOW = 0x00020000

hwnd = ctypes.windll.user32.GetParent(root.winfo_id())
style = ctypes.windll.user32.GetClassLongPtrW(hwnd, GCL_STYLE)
ctypes.windll.user32.SetClassLongPtrW(hwnd, GCL_STYLE, style | CS_DROPSHADOW)

W , H = 400, 300
sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
x = int((sw - W)/2)
y = int((sh - H)/2)
root.geometry(f"{W}x{H}+{x}+{y}")

randNum = random.randint(1, 100)
# label = tk.Label(root, text=f"Random number is: {randNum}") 
# label.pack()

label = tk.Label(root, text="Guess the number:", font=("Segoe UI", 24, "bold"), fg="#333333", bg="#EDEDBD")
label.place(x=45, y=30)

entry = tk.Entry(root, width=30, bg="white", relief="solid", bd=3, highlightthickness=2, highlightbackground="#888",  highlightcolor="#50B4B4")
entry.place(x=100, y=90)

def both():
    show_input()
    decrease_turn()

turns_left = 5


label = tk.Label(root, text=f"Remaining turns: {turns_left}", font=("Arial", 14), fg='#007BFF', bg = '#EDEDBD')
label.place(x=100, y=170)


def decrease_turn():
    global turns_left
    turns_left -= 1
    
    if turns_left > 0:
        label.config(text=f"Remaining turns: {turns_left}")
    else:
        label.config(text="Remaining turns: 0")
        messagebox.showinfo("Game Over", f"Number of turns have ended!\nThe rigth number is: {randNum}")
        button.config(state="disabled") 


guessList = []
def show_input():
    user_input = int(entry.get())


    if (user_input != randNum):

        guessList.append(user_input)
        prev_list = tk.Label(root, text = f"Previous guess: {guessList}", font=("Arial", 14), fg='#007BFF', bg = '#EDEDBD')
        prev_list.place(x = 50, y = 140)
       
    else:
        messagebox.showinfo("Number", "You have guessed it right")
        button.config(state="disabled") 

def reset_turns():
    global turns_left
    turns_left = 5
    label.config(text=f"Remaining turns: {turns_left}")
    button.config(state="normal")
    messagebox.showinfo("Reset", "Turns have been reset!")
    guessList.clear()


button = tk.Button(root, text="Submit", font=("Arial", 15), command=both, width='10',bg = "#00E5FF",fg="#FFFFFF")
button.place(x = 50,y = 230)

reset_button = tk.Button(root, text="Reset Turns", font=("Arial", 15), bg = "#E1E1E1",fg="#3F3F3F", command=reset_turns)
reset_button.place(x=220, y=230)

root.mainloop()
